# server. OPENAI_API_KEY is needed for meal photo analysis.
OPENAI_API_KEY=
OPENAI_MODEL=
# protects GET /api/signup/export.csv, the route is off while this is empty
ADMIN_TOKEN=

# optional server settings. uncomment only the ones you set, an empty value
# replaces the default.
# PORT=
# PUBLIC_URL=
# LANDING_URL=
# SIGNUP_ORIGINS=
# DAILY_PHOTO_LIMIT=
# DAILY_SPEND_CAP_USD=
# CHUNGI_VAR=
# CHUNGI_DB=

# app analytics, off unless both are set at build time
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=

# landing page build (site/build.py). analytics is off unless both are set.
# CHUNGI_SIGNUP_API=
UMAMI_SRC=
UMAMI_WEBSITE_ID=
